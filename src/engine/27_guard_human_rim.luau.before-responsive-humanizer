-- Guard polish.
--  * Humanizer: the guard aims at a lagging, slowly drifting spot instead of the exact one, and
--    holds still inside a wider band before it starts moving again, so it stops twitching like a bot.
--  * Rim press: once the ball handler is within `rimPressRange` studs of the hoop the guard closes
--    to `rimPressGap` studs from them (body up on the dunk) instead of keeping the normal stand-off.
do (function()
 settings.guardHuman=true;settings.guardHumanLevel=60
 settings.rimPress=true;settings.rimPressRange=18;settings.rimPressGap=1.3
 numericLimits.guardHumanLevel={0,100};numericLimits.rimPressRange={8,30};numericLimits.rimPressGap={.75,3}
 local aim,lastAt,holding=nil,0,false
 local seed=math.random()*100
 settings._humanize=function(desired,dt)
  local level=math.clamp(settings.guardHumanLevel or 0,0,100)/100
  dt=math.clamp(dt or 1/60,0,.1)
  local now=os.clock()
  if not aim or now-lastAt>.4 or flat(aim-desired).Magnitude>12 then aim=desired end
  lastAt=now
  -- The aim follows the true spot with a lag (fast at 0, about a fifth of a second at 100).
  aim=aim:Lerp(desired,1-math.exp(-dt*(14-9*level)))
  -- A slow drift, never per-frame randomness.
  local t=now*.6
  return aim+Vector3.new(math.noise(t,seed,0),0,math.noise(t,seed,7.3))*(1.8*level)
 end
 settings._humanHold=function(distance,deadzone)
  local level=math.clamp(settings.guardHumanLevel or 0,0,100)/100
  local release=deadzone*(1.4+1.2*level)+.15
  if distance<deadzone then holding=true
  elseif not(holding and distance<release)then holding=false end
  return holding
 end
 local previous=featureCleanup
 featureCleanup=function()settings._humanize=nil;settings._humanHold=nil;previous()end
end)() end
